{
  "name": "xmpp_p2p",
  "version": "1.5.21",
  "description": "XMPP over libp2p",
  "main": "dist/electron/main.js",
  "desktopName": "app.nexus.xmpp.desktop",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "build:web": "npm run build:browser && npm --prefix ui run build",
    "ui:dev": "npm run build:browser && npm --prefix ui run dev",
    "ui:build": "npm run build:web",
    "ui:preview": "npm --prefix ui run preview",
    "build:browser": "node esbuild.browser.mjs",
    "build:electron": "npm run build && node scripts/build-preload.mjs",
    "electron:dev": "npm run build:web && npm run build:electron && electron .",
    "dist:desktop": "npm run build:web && npm run build:electron && electron-builder --publish never",
    "android:sync": "npm run build:web && npx cap sync android",
    "dist:android": "npm run android:sync && node scripts/sync-version.mjs && cd android && ./gradlew assembleRelease",
    "test-nodes": "node dist/tests/nodes.js",
    "test-pubsub": "node dist/tests/pubsub.js",
    "test-roster": "node dist/tests/roster.js",
    "test-feed": "node dist/tests/feed.js",
    "test-replies": "node dist/tests/replies.js",
    "test-threads": "node dist/tests/threads.js",
    "test-storage-node-sqlite": "node dist/tests/storage-node-sqlite.js",
    "test-storage-indexeddb": "node dist/tests/storage-indexeddb.js",
    "test-p2p-browser": "node dist/tests/p2p-browser.js",
    "test-nostr-bootstrap": "node dist/tests/nostr-bootstrap.js",
    "test-persistence-storage": "node dist/tests/persistence-storage.js",
    "test-openpgp-storage": "node dist/tests/openpgp-storage.js",
    "test-omemo-state-storage": "node dist/tests/omemo-state-storage.js",
    "test-uploads-storage": "node dist/tests/uploads-storage.js",
    "test-omemo-runtime-browser": "node dist/tests/omemo-runtime-browser.js",
    "test-attachments": "node dist/tests/attachments.js",
    "test-subscriptions": "node dist/tests/subscriptions.js",
    "test-disco": "node dist/tests/disco.js",
    "test-protocol": "node dist/tests/protocol.js",
    "test-dht": "node dist/tests/dht.js",
    "test-openpgp": "node dist/tests/openpgp.js",
    "test-omemo": "node dist/tests/omemo.js",
    "test-collection": "node dist/tests/collection.js",
    "test-muc": "node dist/tests/muc.js",
    "test-muc-omemo": "node dist/tests/muc-omemo.js",
    "test-uploads": "node dist/tests/uploads.js",
    "test-reliability": "node dist/tests/xeps-reliability.js",
    "test-dht-mailbox": "node dist/tests/dht-mailbox.js",
    "test-reconnect": "node dist/tests/reconnect.js",
    "test-server-bridge-routing": "node dist/tests/server-bridge-routing.js",
    "test-server-microblog-publish": "node dist/tests/xmpp-server-microblog-publish.js",
    "test-server-bridge-real": "node dist/tests/server-bridge-real.js",
    "test-xmpp-discovery": "node dist/tests/xmpp-discovery.js",
    "test": "npm run build && npm run test-nodes && npm run test-pubsub && npm run test-dht && npm run test-dht-mailbox && npm run test-omemo && npm run test-roster && npm run test-feed && npm run test-server-microblog-publish && npm run test-attachments && npm run test-uploads && npm run test-subscriptions && npm run test-disco && npm run test-protocol && npm run test-collection && npm run test-muc && npm run test-muc-omemo && npm run test-reliability && npm run test-reconnect && npm run test-server-bridge-routing && npm run test-xmpp-discovery && npm run test-storage-node-sqlite && npm run test-storage-indexeddb && npm run test-p2p-browser && npm run test-nostr-bootstrap && npm run test-persistence-storage && npm run test-openpgp-storage && npm run test-omemo-state-storage && npm run test-uploads-storage && npm run test-omemo-runtime-browser",
    "pretest-browser-e2e": "npm run ui:build && node esbuild.fixture.mjs",
    "test-browser-smoke": "playwright test tests-e2e/topic-source-follow.spec.ts tests-e2e/ui-onboarding.spec.ts --grep \"Topics discover P2P and XMPP sources|shows welcome page for unauthenticated users\"",
    "test-browser-e2e": "npx playwright test",
    "test:electron": "npx playwright test tests-e2e/electron.spec.ts",
    "docs": "typedoc --out docs --entryPointStrategy expand src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imattau/XMPP_P2P.git"
  },
  "keywords": [],
  "author": "",
  "license": "LGPL-2.1-or-later",
  "type": "module",
  "bugs": {
    "url": "https://github.com/imattau/XMPP_P2P/issues"
  },
  "homepage": "https://github.com/imattau/XMPP_P2P#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@libp2p/bootstrap": "^12.0.25",
    "@libp2p/circuit-relay-v2": "^4.2.7",
    "@libp2p/gossipsub": "^16.0.3",
    "@libp2p/identify": "^4.1.8",
    "@libp2p/kad-dht": "^16.3.3",
    "@libp2p/mdns": "^12.0.25",
    "@libp2p/noise": "^1.0.1",
    "@libp2p/ping": "^3.1.7",
    "@libp2p/tcp": "^11.0.22",
    "@libp2p/utils": "^7.2.3",
    "@libp2p/webrtc": "^6.0.25",
    "@libp2p/websockets": "^10.1.15",
    "@libp2p/yamux": "^8.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@multiformats/multiaddr-matcher": "^3.0.2",
    "@xmpp/client": "^0.14.0",
    "@xmpp/component": "^0.14.0",
    "@xmpp/websocket": "^0.14.0",
    "@xmpp/xml": "^0.14.0",
    "blessed": "^0.1.81",
    "libomemo.js": "^1.0.0",
    "libp2p": "^3.3.4",
    "nostr-tools": "^2.25.4",
    "openpgp": "^6.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.61.0",
    "@types/blessed": "^0.1.27",
    "@types/node": "^25.9.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  }
}
